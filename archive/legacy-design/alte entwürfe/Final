<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nova Shift – Creative Agency</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Rajdhani:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #c9a84c;
    --gold-light: #e8cc80;
    --gold-dim: #a08442;
    --bg: #080808;
    --bg2: #0f0f0f;
    --bg3: #141414;
    --surface: #1a1a1a;
    --border: rgba(201,168,76,0.18);
    --border-bright: rgba(201,168,76,0.5);
    --text: #f0ede4;
    --text-muted: #b0aa9a;
    --text-dim: #7d7870;
    --font-display: 'Cormorant Garamond', serif;
    --font-ui: 'Rajdhani', sans-serif;
    --font-mono: 'Space Mono', monospace;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-ui);
    overflow-x: hidden;
    cursor: auto;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.12'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1000;
    opacity: 0.55;
    mix-blend-mode: screen;
  }

  body::after {
    content: 'NOVA SHIFT';
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: clamp(5rem, 18vw, 16rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(201, 168, 76, 0.055);
    pointer-events: none;
    z-index: 0;
    white-space: nowrap;
    user-select: none;
  }

  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0,5rem 0,5rem;
    background: linear-gradient(to bottom, rgba(8,8,8,0.98) 0%, transparent 100%);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(201,168,76,0.06);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }

  .nav-logo img {
    height: 44px;
    width: auto;
    transform: scale(5);
    transform-origin: left center;
    margin-top: 90px;
  } 

  .nav-links {
    display: flex;
    gap: 0;
    list-style: none;
  }

  .nav-home-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.2rem;
    color: var(--gold-dim);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.3s;
    border-right: 1px solid var(--border);
    margin-right: 0.5rem;
  }
  .nav-home-btn:hover { color: var(--gold-light); }
  .nav-home-btn svg {
    width: 12px; height: 12px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-links a {
    display: block;
    padding: 0.5rem 1.2rem;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.3s;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0; left: 50%; right: 50%;
    height: 1px;
    background: var(--gold);
    transition: all 0.3s;
  }
  .nav-links a:hover { color: var(--gold-light); }
  .nav-links a:hover::after { left: 1.2rem; right: 1.2rem; }
  .nav-links a.active { color: var(--gold); }
  .nav-links a.active::after { left: 1.2rem; right: 1.2rem; }

  .nav-cta {
    background: transparent;
    border: 1px solid var(--border-bright);
    color: var(--gold);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.55rem 1.4rem;
    transition: all 0.3s;
    cursor: pointer;
  }
  .nav-cta:hover { background: var(--gold); color: var(--bg); }

  .page-section { display: none; min-height: 100vh; }
  .page-section.active { display: block; }
  .page-section { animation: fadeSlideIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }

  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(30px) scale(0.99); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 12rem 3rem 4rem;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 80%);
  }

  .hero-orb { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }
  .hero-orb-1 { width: 600px; height: 600px; top: -200px; left: -200px; background: radial-gradient(circle, rgba(201,168,76,0.07) 0%, transparent 70%); }
  .hero-orb-2 { width: 400px; height: 400px; bottom: -100px; right: -100px; background: radial-gradient(circle, rgba(201,168,76,0.05) 0%, transparent 70%); }

  .hero-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    color: var(--gold-dim);
    text-transform: uppercase;
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeIn 1s 0.3s forwards;
    font-weight: 700;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 300;
    line-height: 1.0;
    text-align: center;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeIn 1s 0.5s forwards;
  }
  .hero-title em { font-style: italic; color: var(--gold); }

  .hero-subtitle {
    font-family: var(--font-ui);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
    max-width: 500px;
    line-height: 2;
    margin-bottom: 3.5rem;
    opacity: 0;
    animation: fadeIn 1s 0.7s forwards;
  }

  .hero-logo-display { margin-bottom: 2rem; opacity: 0; animation: fadeIn 1s 0.4s forwards; }
  .hero-logo-display img { height: 60px; width: auto; 
  }
  .hero-services { display: flex; gap: 2px; flex-wrap: wrap; justify-content: center; margin-bottom: 4rem; opacity: 0; animation: fadeIn 1s 0.9s forwards; }
  .hero-service-pill {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 0.4rem 1rem;
    border: 1px solid rgba(201,168,76,0.08);
    transition: all 0.3s;
  }
  .hero-service-pill:hover { color: var(--gold); border-color: var(--border-bright); background: rgba(201,168,76,0.04); }

  .hero-cta-group { display: flex; gap: 1rem; opacity: 0; animation: fadeIn 1s 1.1s forwards; }

  .btn-primary {
    background: var(--gold);
    color: var(--bg);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.9rem 2.5rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
  }
  .btn-primary:hover { background: var(--gold-light); transform: translateY(-2px); }

  .btn-outline {
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.9rem 2.5rem;
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.3s;
  }
  .btn-outline:hover { color: var(--gold); border-color: var(--border-bright); transform: translateY(-2px); }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    animation: fadeIn 1s 1.5s forwards;
  }

  .scroll-line { width: 1px; height: 60px; background: linear-gradient(to bottom, transparent, var(--gold-dim)); animation: scrollPulse 2s infinite; }
  @keyframes scrollPulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
  .scroll-text { font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.3em; color: var(--text-dim); text-transform: uppercase; writing-mode: vertical-rl; }
  @keyframes fadeIn { to { opacity: 1; } }

  .service-hero { position: relative; min-height: 55vh; display: flex; align-items: flex-end; padding: 8rem 3rem 4rem; overflow: hidden; }
  .service-hero-logo { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.5rem; }
  .service-hero-logo img { height: 36px; width: auto; filter: brightness(0) invert(1) sepia(1) saturate(0.6) brightness(0.8); opacity: 0.7; }
  .service-hero-bg { position: absolute; inset: 0; background: var(--bg); }
  .service-hero-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(201,168,76,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .service-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, var(--bg) 20%, transparent 100%); }
  .service-hero-content { position: relative; z-index: 2; max-width: 900px; }

  .service-tag { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.25em; color: var(--gold-dim); text-transform: uppercase; margin-bottom: 1rem; display: flex; align-items: center; gap: 1rem; font-weight: 700; }
  .service-tag::before { content: ''; display: inline-block; width: 30px; height: 1px; background: var(--gold-dim); }
  .service-title { font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 5.5rem); font-weight: 300; line-height: 1.0; margin-bottom: 1.2rem; }
  .service-title em { font-style: italic; color: var(--gold); }
  .service-tagline { font-family: var(--font-ui); font-size: 1.1rem; font-weight: 400; letter-spacing: 0.08em; color: var(--text-muted); max-width: 500px; line-height: 1.8; }

  .content-section { padding: 5rem 3rem; max-width: 1300px; margin: 0 auto; }

  .three-col { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); margin: 4rem 0; }
  .info-card { background: var(--bg2); padding: 2.5rem; position: relative; overflow: hidden; transition: background 0.4s; }
  .info-card::before { content: ''; position: absolute; top: 0; left: 0; width: 2px; height: 0; background: var(--gold); transition: height 0.4s; }
  .info-card:hover { background: var(--bg3); }
  .info-card:hover::before { height: 100%; }
  .card-number { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.25em; color: var(--gold-dim); margin-bottom: 1.5rem; font-weight: 700; }
  .card-title { font-family: var(--font-display); font-size: 1.6rem; font-weight: 400; color: var(--text); margin-bottom: 1rem; line-height: 1.2; }
  .card-text { font-family: var(--font-ui); font-size: 1rem; font-weight: 400; color: var(--text-muted); line-height: 1.8; }

  .usp-section { padding: 4rem 3rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg2); }
  .usp-inner { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 1fr 2fr; gap: 6rem; align-items: start; }
  .usp-label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.25em; color: var(--gold-dim); text-transform: uppercase; margin-bottom: 1rem; font-weight: 700; }
  .usp-heading { font-family: var(--font-display); font-size: 2.2rem; font-weight: 300; line-height: 1.2; }
  .usp-list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .usp-item { padding: 1.5rem; border: 1px solid var(--border); transition: border-color 0.3s; }
  .usp-item:hover { border-color: var(--border-bright); }
  .usp-item-icon { font-family: var(--font-mono); font-size: 0.82rem; color: var(--gold); margin-bottom: 0.8rem; letter-spacing: 0.1em; font-weight: 700; }
  .usp-item-title { font-family: var(--font-ui); font-size: 0.95rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.5rem; color: var(--text); }
  .usp-item-text { font-size: 0.92rem; color: var(--text-muted); line-height: 1.7; font-weight: 400; }

  .video-placeholder { position: relative; background: var(--bg3); border: 1px solid var(--border); aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; overflow: hidden; margin: 3rem 0; cursor: pointer; }
  .video-placeholder::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(201,168,76,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.03) 1px, transparent 1px); background-size: 30px 30px; }
  .video-play-btn { position: relative; z-index: 2; width: 80px; height: 80px; border: 1px solid var(--border-bright); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s; }
  .video-play-btn::after { content: ''; width: 0; height: 0; border-style: solid; border-width: 12px 0 12px 20px; border-color: transparent transparent transparent var(--gold); margin-left: 4px; }
  .video-placeholder:hover .video-play-btn { background: rgba(201,168,76,0.1); transform: scale(1.1); }
  .video-label { position: absolute; bottom: 1.5rem; left: 1.5rem; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.25em; color: var(--text-dim); text-transform: uppercase; }

  .img-placeholder { background: var(--bg3); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .img-placeholder::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(201,168,76,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.03) 1px, transparent 1px); background-size: 20px 20px; }
  .img-placeholder-label { position: relative; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.25em; color: var(--text-dim); text-transform: uppercase; text-align: center; }

  .split-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; margin: 4rem 0; }
  .split-layout.reverse { direction: rtl; }
  .split-layout.reverse > * { direction: ltr; }

  .section-divider { display: flex; align-items: center; gap: 2rem; margin: 3rem 0; }
  .divider-line { flex: 1; height: 1px; background: var(--border); }
  .divider-text { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.3em; color: var(--gold-dim); text-transform: uppercase; white-space: nowrap; }

  .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--border); margin: 4rem 0; }
  .service-card { background: var(--bg2); padding: 3rem; cursor: pointer; transition: background 0.4s; position: relative; overflow: hidden; }
  .service-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(201,168,76,0.04) 0%, transparent 60%); opacity: 0; transition: opacity 0.4s; }
  .service-card:hover { background: var(--bg3); }
  .service-card:hover::after { opacity: 1; }
  .service-card-num { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.25em; color: var(--gold-dim); margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem; font-weight: 700; }
  .service-card-num::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .service-card-name { font-family: var(--font-display); font-size: 2rem; font-weight: 300; line-height: 1.1; margin-bottom: 0.8rem; }
  .service-card-name em { font-style: italic; color: var(--gold); }
  .service-card-desc { font-size: 0.97rem; color: var(--text-muted); font-weight: 400; line-height: 1.8; margin-bottom: 1.5rem; }
  .service-card-link { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; color: var(--gold-dim); text-transform: uppercase; text-decoration: none; display: flex; align-items: center; gap: 0.8rem; transition: color 0.3s; font-weight: 700; }
  .service-card-link::after { content: '→'; font-size: 0.8rem; transition: transform 0.3s; }
  .service-card:hover .service-card-link { color: var(--gold); }
  .service-card:hover .service-card-link::after { transform: translateX(4px); }

  .section-heading { margin-bottom: 3rem; }
  .section-heading-label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.25em; color: var(--gold-dim); text-transform: uppercase; margin-bottom: 0.8rem; display: flex; align-items: center; gap: 1rem; font-weight: 700; }
  .section-heading-label::before { content: ''; width: 20px; height: 1px; background: var(--gold-dim); }
  .section-heading h2 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 300; line-height: 1.1; }
  .section-heading h2 em { font-style: italic; color: var(--gold); }

  .inline-logo { display: inline-flex; align-items: center; gap: 0.4rem; vertical-align: middle; }
  .inline-logo img { height: 22px; width: auto; filter: brightness(0) invert(1) sepia(1) saturate(0.6) brightness(0.85); opacity: 0.85; position: relative; top: -1px; }

  footer { background: var(--bg2); border-top: 1px solid var(--border); padding: 4rem 3rem 2rem; margin-top: 4rem; }
  .footer-inner { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 4rem; margin-bottom: 3rem; }
  .footer-brand img { height: 50px; filter: brightness(0) invert(1) sepia(1) saturate(0.3) brightness(0.7); opacity: 0.6; margin-bottom: 1rem; }
  .footer-tagline { font-size: 0.92rem; color: var(--text-dim); font-weight: 400; line-height: 1.8; max-width: 240px; }
  .footer-col-title { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em; color: var(--gold-dim); text-transform: uppercase; margin-bottom: 1.2rem; font-weight: 700; }
  .footer-links { list-style: none; }
  .footer-links li { margin-bottom: 0.6rem; }
  .footer-links a { color: var(--text-dim); text-decoration: none; font-size: 0.92rem; font-weight: 400; transition: color 0.3s; letter-spacing: 0.05em; }
  .footer-links a:hover { color: var(--gold); }
  .footer-bottom { max-width: 1300px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding-top: 2rem; border-top: 1px solid var(--border); }
  .footer-copy { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.15em; color: var(--text-dim); font-weight: 700; }

  .stat-bar { display: flex; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg2); margin: 4rem 0; }
  .stat-item { flex: 1; padding: 2rem; text-align: center; border-right: 1px solid var(--border); }
  .stat-item:last-child { border-right: none; }
  .stat-number { font-family: var(--font-display); font-size: 2.8rem; font-weight: 300; color: var(--gold); line-height: 1; margin-bottom: 0.4rem; }
  .stat-label { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.25em; color: var(--text-dim); text-transform: uppercase; font-weight: 700; }

  .contact-block { max-width: 700px; margin: 0 auto; text-align: center; padding: 5rem 3rem; }
  .contact-block h2 { font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 300; line-height: 1.1; margin-bottom: 1.5rem; }
  .contact-block h2 em { font-style: italic; color: var(--gold); }
  .contact-block p { font-size: 0.9rem; color: var(--text-muted); font-weight: 300; line-height: 1.8; margin-bottom: 2.5rem; }

  .mobile-menu-btn { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border: none; padding: 4px; }
  .mobile-menu-btn span { display: block; width: 24px; height: 1px; background: var(--text-muted); transition: all 0.3s; }

  @media (max-width: 900px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    .mobile-menu-btn { display: flex; }
    .nav-cta { display: none; }
    .nav-links.open { display: flex; flex-direction: column; position: fixed; top: 60px; left: 0; right: 0; background: rgba(8,8,8,0.98); backdrop-filter: blur(20px); padding: 2rem; border-bottom: 1px solid var(--border); z-index: 499; }
    .three-col { grid-template-columns: 1fr; }
    .services-grid { grid-template-columns: 1fr; }
    .split-layout { grid-template-columns: 1fr; gap: 2rem; }
    .split-layout.reverse { direction: ltr; }
    .usp-inner { grid-template-columns: 1fr; gap: 2rem; }
    .usp-list { grid-template-columns: 1fr; }
